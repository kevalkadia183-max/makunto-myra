# Makunto Myra — environment variables
# Copy to .env and fill in. Works on any host (VPS, Docker, Railway, Render,
# Fly.io, AWS, Google Cloud). Nothing here is Replit-specific: when PUBLIC_URL
# is set it always wins over any platform-provided domain variables.

# ----- Core -----
NODE_ENV=production                 # development | staging | production
PORT=3001                           # API server port
BASE_PATH=/                         # frontend base path (used at build time)
PUBLIC_URL=https://yourdomain.com   # public HTTPS origin of the app (no trailing slash)

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgres://user:password@host:5432/myra

# ----- Auth (Clerk) -----
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
SESSION_SECRET=generate-a-long-random-string

# ----- AI -----
# Any OpenAI-compatible endpoint works.
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# ----- Voice -----
ELEVENLABS_API_KEY=

# ----- YouTube / Google -----
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_SECRET=
# Optional aliases / overrides:
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/social/oauth/youtube/callback

# ----- Meta (Facebook / Instagram) -----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=https://yourdomain.com/api/social/oauth/facebook/callback
